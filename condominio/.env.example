# Copie para .env e preencha. Sem as duas linhas do Supabase, o app abre em modo DEMONSTRAÇÃO.
# Onde achar: painel do Supabase > Project Settings > API (Project URL e a chave "anon public").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Nome que aparece no topo, ao lado de "Condomínio" (opcional)
VITE_NOME_CONDOMINIO=
