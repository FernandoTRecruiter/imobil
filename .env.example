# Copie para .env.local e preencha. Nunca coloque chave de verdade neste arquivo nem no Git.

# De onde vêm os dados: "mock" (dados fictícios no navegador, padrão) ou "supabase" (fase 2, ainda não ligado).
VITE_DATA_SOURCE=mock

# Fase 2 (Supabase). A chave "anon" é pública por desenho: quem protege o dado é a RLS do banco.
# A chave service_role NUNCA entra aqui: ela ignora a RLS e só existe em Edge Function.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
